  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "esModuleInterop": true, "noEmit": true, "allowImportingTsExtensions": true, "types": ["node"]
